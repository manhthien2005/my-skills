{
  "version": "2.0.0",
  "limits_note": "Character limits are for Vietnamese/English at default theme sizes. Exceeding them is a validation warning: split the slide or move detail to notes; never shrink fonts below theme minimums.",
  "layouts": {
    "cover": {"name": "Cover", "purpose": "Opening: deck title, one-line promise, presenters/meta.", "required": ["title"],
              "optional": ["subtitle", "eyebrow", "meta", "image", "image_alt"], "limits": {"title": 70, "subtitle": 140, "meta": 4},
              "pptx": "native", "motion": "title rise, subtitle and meta stagger", "dark": true},
    "agenda": {"name": "Agenda", "purpose": "Contents / roadmap of the talk with numbered sections.", "required": ["title", "items"],
               "optional": ["subtitle"], "limits": {"items": [2, 6], "item_title": 48, "item_detail": 80}, "pptx": "native",
               "motion": "rows stagger"},
    "section": {"name": "Section divider", "purpose": "Start of a part; sets the question the part answers.", "required": ["title"],
                "optional": ["subtitle", "section_number", "chips"], "limits": {"title": 60, "subtitle": 140}, "pptx": "native",
                "motion": "wipe/rise", "dark": true},
    "statement": {"name": "Statement", "purpose": "One big claim or thesis sentence.", "required": ["title"],
                  "optional": ["subtitle", "note"], "limits": {"title": 120, "subtitle": 160}, "pptx": "native", "motion": "line reveal"},
    "metrics": {"name": "Big numbers", "purpose": "2-4 headline numbers, each one idea, each sourced.", "required": ["title", "items"],
                "optional": ["subtitle"], "limits": {"items": [2, 4], "value": 8, "label": 40, "detail": 90}, "pptx": "native",
                "motion": "tiles stagger + count-up", "numeric": true},
    "kpi-dashboard": {"name": "KPI dashboard", "purpose": "3-6 KPIs with target/delta and status colour, optional sparkline.",
                      "required": ["title", "items"], "optional": ["subtitle", "period"],
                      "limits": {"items": [3, 6], "value": 9, "label": 36, "detail": 60}, "pptx": "native",
                      "motion": "tiles stagger + count-up + sparkline draw", "numeric": true},
    "cards": {"name": "Cards / columns", "purpose": "2-4 parallel groups (categories, criteria, features).", "required": ["title", "items"],
              "optional": ["subtitle", "style"], "limits": {"items": [2, 4], "item_title": 44, "item_body": 130}, "pptx": "native",
              "motion": "cards stagger"},
    "process": {"name": "Process", "purpose": "Ordered steps of a real workflow (3-6).", "required": ["title", "steps"],
                "optional": ["subtitle"], "limits": {"steps": [3, 6], "step_title": 28, "step_detail": 90}, "pptx": "native",
                "motion": "connector draws, steps in order"},
    "timeline": {"name": "Timeline", "purpose": "Chronology or roadmap with done/now/next states.", "required": ["title", "items"],
                 "optional": ["subtitle"], "limits": {"items": [3, 6], "date": 14, "item_title": 30, "item_detail": 80}, "pptx": "native",
                 "motion": "axis draws then milestones stagger"},
    "comparison": {"name": "Comparison", "purpose": "Two alternatives side by side, optional verdict.", "required": ["title", "left", "right"],
                   "optional": ["subtitle", "verdict"], "limits": {"bullets": 5, "bullet": 90, "verdict": 120}, "pptx": "native",
                   "motion": "left then right then verdict"},
    "table": {"name": "Table / matrix", "purpose": "Options x criteria. Rows with hairlines, no grid cells.", "required": ["title", "columns", "rows"],
              "optional": ["subtitle", "highlight", "note"], "limits": {"columns": [2, 5], "rows": [2, 7], "cell": 60}, "pptx": "native",
              "motion": "rows stagger"},
    "chart": {"name": "Chart", "purpose": "One quantitative message. bar|column|line|stacked|donut. Optional insights panel.",
              "required": ["title", "chart"], "optional": ["subtitle", "insights", "caption"],
              "limits": {"categories": [2, 12], "series": [1, 4], "insights": 3, "insight": 110}, "pptx": "native-chart",
              "motion": "bars grow / line draws / donut sweeps", "numeric": true},
    "case": {"name": "Case", "purpose": "One concrete case: place/time, one big number, short story, source.", "required": ["title", "value"],
             "optional": ["value_label", "body", "context", "subtitle"], "limits": {"value": 10, "body": 220}, "pptx": "native",
             "motion": "number counts up", "numeric": true, "dark": true},
    "evidence-levels": {"name": "Evidence levels", "purpose": "Ranked levels (evidence strength, risk, maturity) with examples.",
                        "required": ["title", "levels"], "optional": ["subtitle", "note"],
                        "limits": {"levels": [3, 6], "label": 50, "detail": 90}, "pptx": "native", "motion": "levels build bottom-up"},
    "problem-solution": {"name": "Problem / solution", "purpose": "Pain points on the left, response on the right.",
                         "required": ["title", "problem", "solution"], "optional": ["subtitle"],
                         "limits": {"points": 4, "point": 90}, "pptx": "native", "motion": "problem then solution"},
    "methodology": {"name": "Methodology", "purpose": "Research design: key facts (sample, period, method) + pipeline steps.",
                    "required": ["title", "steps"], "optional": ["subtitle", "facts"],
                    "limits": {"facts": [0, 4], "steps": [2, 5], "step_title": 30, "step_detail": 90}, "pptx": "native",
                    "motion": "facts then steps"},
    "diagram": {"name": "Diagram", "purpose": "Hub-and-spoke or cycle diagram for mechanisms and relationships.",
                "required": ["title", "nodes"], "optional": ["subtitle", "center", "variant"],
                "limits": {"nodes": [3, 6], "node_title": 26, "node_detail": 70}, "pptx": "native", "motion": "centre then nodes"},
    "learning-objectives": {"name": "Learning objectives", "purpose": "What learners can do after the lesson (verbs).",
                            "required": ["title", "items"], "optional": ["subtitle", "lead"],
                            "limits": {"items": [2, 5], "item": 100}, "pptx": "native", "motion": "rows stagger"},
    "definition": {"name": "Definition", "purpose": "One key term: definition, example, caveat.", "required": ["term", "definition"],
                   "optional": ["title", "example", "note", "pronunciation"], "limits": {"term": 40, "definition": 220, "example": 160},
                   "pptx": "native", "motion": "term then definition"},
    "image-split": {"name": "Image split", "purpose": "Half image, half text. Local, licence-cleared image only.",
                    "required": ["title", "image"], "optional": ["subtitle", "bullets", "image_alt", "image_credit", "side"],
                    "limits": {"bullets": 4, "bullet": 90}, "pptx": "native", "motion": "image reveal + text stagger"},
    "full-bleed-image": {"name": "Full-bleed image", "purpose": "Emotional or evidence image filling the slide with a short caption.",
                         "required": ["title", "image"], "optional": ["subtitle", "image_alt", "image_credit"],
                         "limits": {"title": 80, "subtitle": 140}, "pptx": "native", "motion": "slow zoom + caption rise"},
    "quote": {"name": "Quote", "purpose": "A verified, attributed quotation.", "required": ["quote", "attribution"],
              "optional": ["title"], "limits": {"quote": 220}, "pptx": "native", "motion": "quote fade"},
    "key-takeaways": {"name": "Key takeaways", "purpose": "2-4 conclusions/recommendations to remember.", "required": ["title", "bullets"],
                      "optional": ["subtitle"], "limits": {"bullets": [2, 4], "bullet": 110}, "pptx": "native", "motion": "rows stagger"},
    "references": {"name": "References", "purpose": "Citations list (numbered).", "required": ["title", "items"],
                   "optional": [], "limits": {"items": [1, 8], "item": 200}, "pptx": "native", "motion": "none"},
    "closing": {"name": "Closing", "purpose": "Thank you / Q&A / call to action with contact.", "required": ["title"],
                "optional": ["subtitle", "meta"], "limits": {"title": 50, "subtitle": 140}, "pptx": "native", "motion": "title rise",
                "dark": true}
  },
  "aliases": {"columns": "cards", "summary": "key-takeaways", "image": "image-split", "stats": "metrics", "big-numbers": "metrics",
              "chart-insight": "chart", "toc": "agenda", "contents": "agenda", "thanks": "closing", "title": "cover"}
}

