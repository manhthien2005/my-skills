{
  "preferred_language": "vi",
  "default_theme": "editorial-cream",
  "aspect_ratio": "16:9",
  "design_principles": [
    "one-message-per-slide",
    "claim-led-titles",
    "no-unsourced-numbers",
    "editorial-visual-hierarchy",
    "source-visible",
